   "anchor": "inline",
   "page": 8,
   "bbox": [
    308.28,
    482.37,
    473.98,
    492.8
   ],
   "number": "",
   "text": "註:「AIA Vitality 健康程式」並非保險產品,加",
   "textPages": [
    8
   ]
  }
